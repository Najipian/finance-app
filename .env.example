# Copy to .env (git-ignored) and fill in. Placeholders only: never commit real values.
# Used by docker compose and by `uv run` from backend/ (it reads ../.env).

# local | test | production  (production switches logs to JSON)
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# PostgreSQL (also configures the postgres container)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance_app

# Redis (arq queue)
REDIS_URL=redis://localhost:6379/0

# Auth (BR-01). Generate a secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Rate limiting on auth endpoints (counted in Redis; fails open if Redis is down)
RATE_LIMIT_ENABLED=true
# Requests per minute per client IP, per auth endpoint
AUTH_RATE_LIMIT_PER_MINUTE=10
# Login attempts per account (any IP) per window
LOGIN_ACCOUNT_RATE_LIMIT=5
LOGIN_ACCOUNT_WINDOW_SECONDS=900

# Encryption of bank tokens at rest (AES-256-GCM). Generate with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# The placeholder below is invalid on purpose: the app refuses to start until replaced.
TOKEN_ENCRYPTION_KEY=REPLACE_ME_REPLACE_ME_REPLACE_ME_REPLACE_ME_A=
TOKEN_ENCRYPTION_KEY_VERSION=1

# Open Banking provider: mock (offline demo bank) or yapily (sandbox)
BANK_PROVIDER=mock
YAPILY_APPLICATION_UUID=
YAPILY_APPLICATION_SECRET=

# Public URLs used during the bank consent redirect flow
PUBLIC_API_URL=http://localhost:8000
WEB_APP_URL=http://localhost:5173

# Allowed browser origins for the web app, as a JSON list
CORS_ORIGINS=["http://localhost:5173"]
