# Copy to .env (git-ignored) and fill in. Placeholders only: never commit real values.
# Used by docker compose and by `uv run` from backend/ (it reads ../.env).

# local | test | production  (production switches logs to JSON)
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# PostgreSQL (also configures the postgres container)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance_app

# Redis (arq queue)
REDIS_URL=redis://localhost:6379/0

# Allowed browser origins for the web app, as a JSON list
CORS_ORIGINS=["http://localhost:5173"]
